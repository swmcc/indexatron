# Indexatron Configuration
# Copy this file to .env.development or .env.production and fill in values

# =============================================================================
# Environment
# =============================================================================

# Environment name: development or production
INDEXATRON_ENV=development

# Enable debug mode for verbose output (true/false)
INDEXATRON_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
INDEXATRON_LOG_LEVEL=INFO

# =============================================================================
# API Connection (the-mcculloughs.org)
# =============================================================================

# Base URL of the photo API
INDEXATRON_API_BASE_URL=http://localhost:3000

# API key (get this from the-mcculloughs.org admin panel)
# Format: sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INDEXATRON_API_KEY=sk_your_api_key_here

# API request timeout in seconds
INDEXATRON_API_TIMEOUT=30.0

# =============================================================================
# Ollama Configuration
# =============================================================================

# Ollama server URL
INDEXATRON_OLLAMA_HOST=http://localhost:11434

# Vision model for image analysis
INDEXATRON_VISION_MODEL=llava:7b

# Embedding model for vector generation
INDEXATRON_EMBEDDING_MODEL=nomic-embed-text

# Ollama request timeout in seconds (LLaVA can be slow)
INDEXATRON_OLLAMA_TIMEOUT=120.0

# =============================================================================
# Processing
# =============================================================================

# Number of uploads to fetch per batch
INDEXATRON_BATCH_SIZE=10

# Directory for temporary image downloads
INDEXATRON_DOWNLOAD_DIR=/tmp/indexatron
